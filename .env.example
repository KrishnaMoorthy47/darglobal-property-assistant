OPENROUTER_API_KEY=
# optional second OpenRouter key, used when the first one's daily limit is reached
OPENROUTER_API_KEY_2=
# optional third key, for embeddings and question understanding
OPENROUTER_API_KEY_3=
GROQ_API_KEY=

# token for /admin
ADMIN_TOKEN=

# APP_URL=https://<your-service>.onrender.com
# settings.yaml values can be overridden too, e.g. LLM__GENERATION__MAX_TOKENS=900

# optional, for persistent logs (use the secret key, not the anon key)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
